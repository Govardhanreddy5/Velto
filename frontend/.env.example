# ==============================================================================
# Velto Environment Configuration
# Copy this file to .env.local for local development.
# For Vercel production, configure these variables in Project Settings > Environment Variables.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Public API Key (safe for client-side use with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Next.js public site URL for production OAuth/email redirects
# Default is http://localhost:3000 locally; set to your Vercel URL in production (e.g. https://velto.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Web Push (VAPID) Configuration
# ==============================================================================
# Vercel: Public Config (Visible to Browser)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Vercel: Secret (Server-Only, NEVER expose to browser/client code)
VAPID_PRIVATE_KEY=your-vapid-private-key

# Vercel: Config (Contact URI for Web Push standard compliance)
VAPID_SUBJECT=mailto:support@velto.local
